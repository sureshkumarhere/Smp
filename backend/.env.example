PORT=9000
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/chat-app?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Allowed email domains (* for any, or comma-separated list like mnnit.ac.in,gmail.com)
ALLOWED_EMAIL_DOMAINS=*

# Google OAuth Client ID (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
